<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.visolearn.BatchController"
      style="-fx-background-color: #1A1A24; -fx-padding: 24;"
      spacing="18">

    <!-- ══════════════════════════════════════════════════════════════════════
         PAGE HEADER
         ══════════════════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <!-- Accent bar -->
            <Region minWidth="4" minHeight="36" maxWidth="4"
                    style="-fx-background-color: linear-gradient(to bottom, #A78BFA, #10B981);
                           -fx-background-radius: 2;"/>
            <VBox spacing="3">
                <Label text="Batch Analysis"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;
                              -fx-text-fill: #F8F9FA;"/>
                <Label text="Run parallel ensemble inference on an entire folder of dermoscopy images"
                       style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
            </VBox>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Badge -->
        <HBox alignment="CENTER" spacing="6"
              style="-fx-background-color: rgba(167,139,250,0.12);
                     -fx-background-radius: 20;
                     -fx-border-color: rgba(167,139,250,0.25);
                     -fx-border-radius: 20;
                     -fx-border-width: 1;
                     -fx-padding: 6 14 6 14;">
            <Label text="&#9889;"
                   style="-fx-font-size: 13px; -fx-text-fill: #A78BFA;"/>
            <Label text="ExecutorService Pool"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #A78BFA;"/>
        </HBox>
    </HBox>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROW 1 — Folder picker + buttons
         ══════════════════════════════════════════════════════════════════════ -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="glass-card"
          style="-fx-padding: 14 16 14 16;">

        <!-- Folder icon (styled Label, not emoji) -->
        <Label text="&#128193;"
               style="-fx-font-size: 17px; -fx-text-fill: #9CA3AF; -fx-padding: 0 4 0 0;"/>

        <TextField fx:id="folderPathField"
                   promptText="Select a folder containing JPG / PNG images..."
                   HBox.hgrow="ALWAYS"
                   editable="false"
                   style="-fx-background-color: #1A1A24;
                          -fx-text-fill: #E5E7EB;
                          -fx-prompt-text-fill: #4B5563;
                          -fx-font-size: 13px;
                          -fx-font-family: 'Consolas', monospace;
                          -fx-padding: 10 14 10 14;
                          -fx-background-radius: 8;
                          -fx-border-color: rgba(255,255,255,0.08);
                          -fx-border-radius: 8;
                          -fx-border-width: 1;"/>

        <Button fx:id="selectFolderButton"
                text="Browse Folder"
                onAction="#handleSelectFolder"
                styleClass="secondary-btn"
                style="-fx-padding: 10 18 10 18;"/>

        <Button fx:id="runBatchButton"
                text="&#9654;  Run Analysis"
                onAction="#handleRunBatch"
                disable="true"
                styleClass="primary-btn"
                style="-fx-padding: 10 22 10 22;"/>

        <Button fx:id="exportCsvButton"
                text="Export CSV"
                onAction="#handleExportCsv"
                disable="true"
                styleClass="secondary-btn"
                style="-fx-padding: 10 18 10 18;"/>
    </HBox>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROW 2 — Thread-pool configuration card
         ══════════════════════════════════════════════════════════════════════ -->
    <HBox styleClass="glass-card"
          style="-fx-padding: 0; -fx-background-radius: 12;"
          spacing="0">

        <!-- Left accent panel -->
        <VBox alignment="CENTER" minWidth="110" maxWidth="110"
              style="-fx-background-color: linear-gradient(to bottom, rgba(167,139,250,0.18), rgba(16,185,129,0.12));
                     -fx-background-radius: 12 0 0 12;
                     -fx-padding: 20 16 20 16;"
              spacing="6">
            <!-- Gear icon — plain Unicode, styled via Label color -->
            <Label text="&#9881;"
                   style="-fx-font-size: 24px; -fx-text-fill: #A78BFA;"/>
            <Label text="THREAD"
                   style="-fx-font-size: 9px; -fx-font-weight: bold;
                          -fx-text-fill: #9CA3AF; -fx-letter-spacing: 1.8px;"/>
            <Label text="POOL"
                   style="-fx-font-size: 9px; -fx-font-weight: bold;
                          -fx-text-fill: #9CA3AF; -fx-letter-spacing: 1.8px;"/>
        </VBox>

        <!-- Divider -->
        <Region minWidth="1" maxWidth="1"
                style="-fx-background-color: rgba(255,255,255,0.06);"/>

        <!-- Centre: live label + slider -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT"
              style="-fx-padding: 18 24 18 24;" spacing="10">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="threadCountLabel"
                       text="2 Threads"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;
                              -fx-text-fill: #A78BFA;"/>
                <Label text="active workers"
                       style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
            </HBox>

            <Slider fx:id="threadSlider"
                    min="1" max="4" value="2"
                    majorTickUnit="1" minorTickCount="0"
                    snapToTicks="true"
                    showTickLabels="true"
                    showTickMarks="true"
                    maxWidth="Infinity"
                    style="-fx-control-inner-background: #2D2D3A;
                           -fx-padding: 4 0 0 0;"/>
        </VBox>

        <!-- Divider -->
        <Region minWidth="1" maxWidth="1"
                style="-fx-background-color: rgba(255,255,255,0.06);"/>

        <!-- Right: 4 option tiles (fx:id so Java can swap highlight) -->
        <HBox alignment="CENTER" spacing="10"
              style="-fx-padding: 16 20 16 20;">

            <!-- Tile 1 — Single -->
            <VBox fx:id="tile1" alignment="CENTER" spacing="4"
                  style="-fx-background-color: rgba(255,255,255,0.04);
                         -fx-background-radius: 8; -fx-padding: 10 14 10 14;
                         -fx-border-color: rgba(255,255,255,0.07);
                         -fx-border-radius: 8; -fx-border-width: 1;
                         -fx-min-width: 56; -fx-cursor: hand;">
                <Label text="1"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F8F9FA;"/>
                <Label text="Single"
                       style="-fx-font-size: 9px; -fx-text-fill: #6B7280;"/>
            </VBox>

            <!-- Tile 2 — Default (starts highlighted) -->
            <VBox fx:id="tile2" alignment="CENTER" spacing="4"
                  style="-fx-background-color: rgba(167,139,250,0.14);
                         -fx-background-radius: 8; -fx-padding: 10 14 10 14;
                         -fx-border-color: rgba(167,139,250,0.35);
                         -fx-border-radius: 8; -fx-border-width: 1;
                         -fx-min-width: 56; -fx-cursor: hand;">
                <Label text="2"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #A78BFA;"/>
                <Label text="Default"
                       style="-fx-font-size: 9px; -fx-text-fill: #A78BFA;"/>
            </VBox>

            <!-- Tile 3 — Fast -->
            <VBox fx:id="tile3" alignment="CENTER" spacing="4"
                  style="-fx-background-color: rgba(255,255,255,0.04);
                         -fx-background-radius: 8; -fx-padding: 10 14 10 14;
                         -fx-border-color: rgba(255,255,255,0.07);
                         -fx-border-radius: 8; -fx-border-width: 1;
                         -fx-min-width: 56; -fx-cursor: hand;">
                <Label text="3"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F8F9FA;"/>
                <Label text="Fast"
                       style="-fx-font-size: 9px; -fx-text-fill: #6B7280;"/>
            </VBox>

            <!-- Tile 4 — Max -->
            <VBox fx:id="tile4" alignment="CENTER" spacing="4"
                  style="-fx-background-color: rgba(255,255,255,0.04);
                         -fx-background-radius: 8; -fx-padding: 10 14 10 14;
                         -fx-border-color: rgba(255,255,255,0.07);
                         -fx-border-radius: 8; -fx-border-width: 1;
                         -fx-min-width: 56; -fx-cursor: hand;">
                <Label text="4"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F8F9FA;"/>
                <Label text="Max"
                       style="-fx-font-size: 9px; -fx-text-fill: #6B7280;"/>
            </VBox>
        </HBox>

    </HBox>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROW 3 — Progress bar
         ══════════════════════════════════════════════════════════════════════ -->
    <VBox fx:id="progressBox"
          visible="false"
          styleClass="glass-card"
          style="-fx-padding: 16 20 16 20;"
          spacing="10">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <ProgressIndicator
                    style="-fx-progress-color: #A78BFA;"
                    prefWidth="16" prefHeight="16"/>
            <Label fx:id="progressLabel"
                   text="Initialising batch..."
                   style="-fx-font-size: 13px; -fx-text-fill: #D1D5DB;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="progressCountLabel"
                   text="0 / 0"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;
                          -fx-text-fill: #A78BFA;"/>
        </HBox>

        <ProgressBar fx:id="batchProgressBar"
                     progress="0"
                     maxWidth="Infinity"
                     prefHeight="8"
                     style="-fx-accent: #A78BFA;"/>

    </VBox>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROW 4 — Summary stat cards
         ══════════════════════════════════════════════════════════════════════ -->
    <HBox fx:id="summaryBox" visible="false" spacing="14">

        <!-- Total images -->
        <VBox HBox.hgrow="ALWAYS" spacing="6"
              style="-fx-background-color: #252533;
                     -fx-background-radius: 12;
                     -fx-border-color: rgba(255,255,255,0.06);
                     -fx-border-radius: 12; -fx-border-width: 1;
                     -fx-padding: 16 18 16 18;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),12,0,0,4);">
            <Label text="TOTAL IMAGES"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #6B7280; -fx-letter-spacing: 1.4px;"/>
            <Label fx:id="totalImagesLabel" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold;
                          -fx-text-fill: #F8F9FA;"/>
            <Label text="images processed"
                   style="-fx-font-size: 11px; -fx-text-fill: #4B5563;"/>
        </VBox>

        <!-- Top class -->
        <VBox HBox.hgrow="ALWAYS" spacing="6"
              style="-fx-background-color: #252533;
                     -fx-background-radius: 12;
                     -fx-border-color: rgba(0,180,216,0.2);
                     -fx-border-radius: 12; -fx-border-width: 1;
                     -fx-padding: 16 18 16 18;
                     -fx-effect: dropshadow(gaussian,rgba(0,180,216,0.1),12,0,0,4);">
            <Label text="TOP CLASS"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #6B7280; -fx-letter-spacing: 1.4px;"/>
            <Label fx:id="topClassLabel" text="&#8212;"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                          -fx-text-fill: #00B4D8; -fx-padding: 4 0 0 0;
                          -fx-wrap-text: true;"/>
            <Label text="most frequent result"
                   style="-fx-font-size: 11px; -fx-text-fill: #4B5563;"/>
        </VBox>

        <!-- Avg confidence -->
        <VBox HBox.hgrow="ALWAYS" spacing="6"
              style="-fx-background-color: #252533;
                     -fx-background-radius: 12;
                     -fx-border-color: rgba(16,185,129,0.2);
                     -fx-border-radius: 12; -fx-border-width: 1;
                     -fx-padding: 16 18 16 18;
                     -fx-effect: dropshadow(gaussian,rgba(16,185,129,0.1),12,0,0,4);">
            <Label text="AVG CONFIDENCE"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #6B7280; -fx-letter-spacing: 1.4px;"/>
            <Label fx:id="avgConfidenceLabel" text="&#8212;"
                   style="-fx-font-size: 32px; -fx-font-weight: bold;
                          -fx-text-fill: #10B981;"/>
            <Label text="ensemble certainty"
                   style="-fx-font-size: 11px; -fx-text-fill: #4B5563;"/>
        </VBox>

        <!-- Processing time -->
        <VBox HBox.hgrow="ALWAYS" spacing="6"
              style="-fx-background-color: #252533;
                     -fx-background-radius: 12;
                     -fx-border-color: rgba(167,139,250,0.2);
                     -fx-border-radius: 12; -fx-border-width: 1;
                     -fx-padding: 16 18 16 18;
                     -fx-effect: dropshadow(gaussian,rgba(167,139,250,0.1),12,0,0,4);">
            <Label text="PROCESSING TIME"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #6B7280; -fx-letter-spacing: 1.4px;"/>
            <Label fx:id="processingTimeLabel" text="&#8212;"
                   style="-fx-font-size: 32px; -fx-font-weight: bold;
                          -fx-text-fill: #A78BFA;"/>
            <Label text="wall-clock duration"
                   style="-fx-font-size: 11px; -fx-text-fill: #4B5563;"/>
        </VBox>

    </HBox>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROW 5 — Results table
         ══════════════════════════════════════════════════════════════════════ -->
    <VBox VBox.vgrow="ALWAYS" styleClass="glass-card"
          style="-fx-padding: 0;" spacing="0">

        <!-- Table header bar -->
        <HBox alignment="CENTER_LEFT"
              style="-fx-padding: 14 20 14 20;
                     -fx-border-color: rgba(255,255,255,0.05);
                     -fx-border-width: 0 0 1 0;
                     -fx-background-color: #1E1E2A;
                     -fx-background-radius: 12 12 0 0;">
            <Label text="Analysis Results"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                          -fx-text-fill: #F8F9FA;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Status legend (plain styled labels, no emoji) -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label text="&#9679;" style="-fx-text-fill: #F59E0B; -fx-font-size: 9px;"/>
                    <Label text="Processing" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label text="&#9679;" style="-fx-text-fill: #10B981; -fx-font-size: 9px;"/>
                    <Label text="Done" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label text="&#9679;" style="-fx-text-fill: #EF4444; -fx-font-size: 9px;"/>
                    <Label text="Error" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
                </HBox>
            </HBox>
        </HBox>

        <TableView fx:id="resultsTable"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-color: transparent;
                          -fx-border-color: transparent;">
            <columns>
                <TableColumn fx:id="fileNameColumn"
                             text="FILE NAME"       prefWidth="240"/>
                <TableColumn fx:id="predictedClassColumn"
                             text="PREDICTED CLASS"  prefWidth="200"/>
                <TableColumn fx:id="confidenceColumn"
                             text="CONFIDENCE"       prefWidth="120"/>
                <TableColumn fx:id="inferenceTimeColumn"
                             text="TIME (MS)"        prefWidth="110"/>
                <TableColumn fx:id="statusColumn"
                             text="STATUS"           prefWidth="140"/>
            </columns>

            <placeholder>
                <VBox alignment="CENTER" spacing="14">
                    <!-- Plain ring icon instead of emoji -->
                    <Label text="&#9673;"
                           style="-fx-font-size: 40px; -fx-text-fill: #374151;"/>
                    <Label text="No results yet"
                           style="-fx-font-size: 15px; -fx-text-fill: #9CA3AF;
                                  -fx-font-weight: bold;"/>
                    <Label text="Select a folder and click Run Analysis to start parallel batch inference"
                           style="-fx-font-size: 12px; -fx-text-fill: #4B5563;
                                  -fx-wrap-text: true; -fx-text-alignment: center;"/>
                </VBox>
            </placeholder>

        </TableView>

    </VBox>

</VBox>