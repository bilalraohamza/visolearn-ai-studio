<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.visolearn.BatchController"
      style="-fx-background-color: #1A1A24; -fx-padding: 24;"
      spacing="20">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4">
            <Label text="Batch Analysis"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8F9FA;"/>
            <Label text="Run ensemble inference on an entire folder of dermoscopy images"
                   style="-fx-font-size: 13px; -fx-text-fill: #9CA3AF;"/>
        </VBox>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="glass-card" style="-fx-padding: 16;">

        <TextField fx:id="folderPathField"
                   promptText="Select a folder containing JPG or PNG images..."
                   HBox.hgrow="ALWAYS"
                   editable="false"
                   style="-fx-background-color: #1A1A24;
                          -fx-text-fill: #F8F9FA;
                          -fx-font-size: 13px;
                          -fx-font-family: monospace;
                          -fx-padding: 10 14 10 14;
                          -fx-background-radius: 8;
                          -fx-border-color: rgba(255,255,255,0.1);
                          -fx-border-radius: 8;
                          -fx-border-width: 1;"/>

        <Button fx:id="selectFolderButton"
                text="Browse Folder"
                onAction="#handleSelectFolder"
                styleClass="secondary-btn"
                style="-fx-padding: 10 16 10 16;"/>

        <Button fx:id="runBatchButton"
                text="Run Analysis"
                onAction="#handleRunBatch"
                disable="true"
                styleClass="primary-btn"
                style="-fx-padding: 10 20 10 20;"/>

        <Button fx:id="exportCsvButton"
                text="Export CSV"
                onAction="#handleExportCsv"
                disable="true"
                styleClass="secondary-btn"
                style="-fx-padding: 10 16 10 16;"/>
    </HBox>

    <VBox fx:id="progressBox"
          visible="false"
          styleClass="glass-card"
          style="-fx-padding: 16;"
          spacing="12">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="progressLabel"
                   text="Classifying images in batch..."
                   style="-fx-font-size: 13px; -fx-text-fill: #9CA3AF;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="progressCountLabel"
                   text="0 / 0"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #F8F9FA;"/>
        </HBox>

        <ProgressBar fx:id="batchProgressBar"
                     progress="0"
                     maxWidth="Infinity"
                     prefHeight="8"
                     style="-fx-accent: #10B981;"/>

    </VBox>

    <HBox fx:id="summaryBox" visible="false" spacing="16">

        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 16;">
            <Label text="TOTAL IMAGES"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9CA3AF; -fx-letter-spacing: 1.4px; -fx-padding: 0 0 8 0;"/>
            <Label fx:id="totalImagesLabel" text="0"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #F8F9FA;"/>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 16;">
            <Label text="MOST COMMON CLASS"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9CA3AF; -fx-letter-spacing: 1.4px; -fx-padding: 0 0 8 0;"/>
            <Label fx:id="topClassLabel" text="—"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #00B4D8; -fx-padding: 4 0 0 0;"/>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 16;">
            <Label text="AVG CONFIDENCE"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9CA3AF; -fx-letter-spacing: 1.4px; -fx-padding: 0 0 8 0;"/>
            <Label fx:id="avgConfidenceLabel" text="—"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #10B981;"/>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 16;">
            <Label text="PROCESSING TIME"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9CA3AF; -fx-letter-spacing: 1.4px; -fx-padding: 0 0 8 0;"/>
            <Label fx:id="processingTimeLabel" text="—"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #A78BFA;"/>
        </VBox>

    </HBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 0; -fx-overflow: hidden;" spacing="0">

        <HBox alignment="CENTER_LEFT"
              style="-fx-padding: 16 20 16 20;
                     -fx-border-color: rgba(255,255,255,0.05);
                     -fx-border-width: 0 0 1 0;
                     -fx-background-color: #1E1E2A;
                     -fx-background-radius: 12 12 0 0;">
            <Label text="Analysis Results"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #F8F9FA;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Sorted by file name"
                   style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
        </HBox>

        <TableView fx:id="resultsTable"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-color: transparent; -fx-border-color: transparent;">

            <columns>
                <TableColumn fx:id="fileNameColumn" text="FILE NAME" prefWidth="280" />
                <TableColumn fx:id="predictedClassColumn" text="PREDICTED CLASS" prefWidth="220" />
                <TableColumn fx:id="confidenceColumn" text="CONFIDENCE" prefWidth="140" />
                <TableColumn fx:id="inferenceTimeColumn" text="TIME (MS)" prefWidth="120" />
            </columns>

            <placeholder>
                <VBox alignment="CENTER" spacing="12">
                    <Label text="No results yet"
                           style="-fx-font-size: 15px; -fx-text-fill: #9CA3AF; -fx-font-weight: bold;"/>
                    <Label text="Select a folder and click Run Analysis to begin processing"
                           style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                </VBox>
            </placeholder>

        </TableView>

    </VBox>

</VBox>