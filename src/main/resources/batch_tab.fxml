<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.visolearn.BatchController"
      styleClass="page-root"
      spacing="18">

    <!-- ── Page header ──────────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Region styleClass="batch-accent-bar"/>
            <VBox spacing="3">
                <Label text="Batch Analysis"     styleClass="page-title"/>
                <Label text="Run parallel ensemble inference on an entire folder of dermoscopy images"
                       styleClass="page-subtitle"/>
            </VBox>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="6" styleClass="badge-pill-purple">
            <Label text="&#9889;" styleClass="text-purple text-md"/>
            <Label text="ExecutorService Pool" styleClass="text-purple text-bold text-md"/>
        </HBox>
    </HBox>

    <!-- ── Folder picker ────────────────────────────────────────────────── -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="glass-card"
          style="-fx-padding: 14 16 14 16;">
        <Label text="&#128193;" styleClass="text-secondary text-lg"
               style="-fx-padding: 0 4 0 0;"/>
        <TextField fx:id="folderPathField"
                   promptText="Select a folder containing JPG / PNG images..."
                   HBox.hgrow="ALWAYS" editable="false"
                   styleClass="bg-base"
                   style="-fx-font-family: 'Consolas', monospace;
                          -fx-padding: 10 14 10 14;
                          -fx-background-radius: 8;
                          -fx-border-color: rgba(255,255,255,0.08);
                          -fx-border-radius: 8; -fx-border-width: 1;"/>
        <Button fx:id="selectFolderButton" text="Browse Folder"
                onAction="#handleSelectFolder" styleClass="secondary-btn"
                style="-fx-padding: 10 18 10 18;"/>
        <Button fx:id="runBatchButton" text="&#9654;  Run Analysis"
                onAction="#handleRunBatch" disable="true" styleClass="primary-btn"
                style="-fx-padding: 10 22 10 22;"/>
        <Button fx:id="exportCsvButton" text="Export CSV"
                onAction="#handleExportCsv" disable="true" styleClass="secondary-btn"
                style="-fx-padding: 10 18 10 18;"/>
    </HBox>

    <!-- ── Thread-pool card ─────────────────────────────────────────────── -->
    <HBox styleClass="glass-card" style="-fx-padding: 0; -fx-background-radius: 12;" spacing="0">

        <VBox alignment="CENTER" minWidth="110" maxWidth="110"
              styleClass="thread-panel-left" spacing="6">
            <Label text="&#9881;" styleClass="text-purple text-2xl"/>
            <Label text="THREAD"  styleClass="thread-pool-label"/>
            <Label text="POOL"    styleClass="thread-pool-label"/>
        </VBox>

        <Region styleClass="thread-panel-divider"/>

        <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT"
              style="-fx-padding: 18 24 18 24;" spacing="10">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="threadCountLabel" text="2 Threads"
                       styleClass="thread-count-label"/>
                <Label text="active workers" styleClass="thread-active-sub"/>
            </HBox>
            <Slider fx:id="threadSlider" min="1" max="4" value="2"
                    majorTickUnit="1" minorTickCount="0"
                    snapToTicks="true" showTickLabels="true"
                    showTickMarks="true" maxWidth="Infinity"
                    style="-fx-control-inner-background: #2D2D3A; -fx-padding: 4 0 0 0;"/>
        </VBox>

        <Region styleClass="thread-panel-divider"/>

        <!-- Tile row -->
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 16 20 16 20;">
            <VBox fx:id="tile1" alignment="CENTER" spacing="4" styleClass="thread-tile">
                <Label text="1" styleClass="text-primary text-xl text-bold"/>
                <Label text="Single" styleClass="text-muted text-xs"/>
            </VBox>
            <VBox fx:id="tile2" alignment="CENTER" spacing="4" styleClass="thread-tile-active">
                <Label text="2" styleClass="text-purple text-xl text-bold"/>
                <Label text="Default" styleClass="text-purple text-xs text-bold"/>
            </VBox>
            <VBox fx:id="tile3" alignment="CENTER" spacing="4" styleClass="thread-tile">
                <Label text="3" styleClass="text-primary text-xl text-bold"/>
                <Label text="Fast" styleClass="text-muted text-xs"/>
            </VBox>
            <VBox fx:id="tile4" alignment="CENTER" spacing="4" styleClass="thread-tile">
                <Label text="4" styleClass="text-primary text-xl text-bold"/>
                <Label text="Max" styleClass="text-muted text-xs"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- ── Progress bar ──────────────────────────────────────────────────── -->
    <VBox fx:id="progressBox" visible="false" styleClass="glass-card"
          style="-fx-padding: 16 20 16 20;" spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ProgressIndicator style="-fx-progress-color: #A78BFA;"
                               prefWidth="16" prefHeight="16"/>
            <Label fx:id="progressLabel" text="Initialising batch..."
                   styleClass="text-light text-md"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="progressCountLabel" text="0 / 0"
                   styleClass="text-purple text-bold text-md"/>
        </HBox>
        <ProgressBar fx:id="batchProgressBar" progress="0"
                     maxWidth="Infinity" prefHeight="8"
                     style="-fx-accent: #A78BFA;"/>
    </VBox>

    <!-- ── Summary cards ─────────────────────────────────────────────────── -->
    <HBox fx:id="summaryBox" visible="false" spacing="14">
        <VBox HBox.hgrow="ALWAYS" styleClass="stat-card" spacing="6">
            <Label text="TOTAL IMAGES"     styleClass="section-cap"/>
            <Label fx:id="totalImagesLabel" text="0" styleClass="stat-value-lg"/>
            <Label text="images processed" styleClass="stat-footnote"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-cyan" spacing="6">
            <Label text="TOP CLASS"           styleClass="section-cap"/>
            <Label fx:id="topClassLabel" text="&#8212;"
                   styleClass="stat-value-cyan"
                   style="-fx-font-size: 18px; -fx-wrap-text: true;"/>
            <Label text="most frequent result" styleClass="stat-footnote"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-emerald" spacing="6">
            <Label text="AVG CONFIDENCE"      styleClass="section-cap"/>
            <Label fx:id="avgConfidenceLabel" text="&#8212;"
                   styleClass="stat-value-lg-emerald"/>
            <Label text="ensemble certainty"  styleClass="stat-footnote"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-purple" spacing="6">
            <Label text="PROCESSING TIME"      styleClass="section-cap"/>
            <Label fx:id="processingTimeLabel" text="&#8212;"
                   styleClass="stat-value-lg-purple"/>
            <Label text="wall-clock duration"  styleClass="stat-footnote"/>
        </VBox>
    </HBox>

    <!-- ── Results table ─────────────────────────────────────────────────── -->
    <VBox VBox.vgrow="ALWAYS" styleClass="glass-card"
          style="-fx-padding: 0;" spacing="0">

        <HBox alignment="CENTER_LEFT" styleClass="table-header-bar">
            <Label text="Analysis Results"
                   styleClass="text-primary text-bold text-md"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label text="&#9679;" styleClass="text-amber text-xs"/>
                    <Label text="Processing" styleClass="hint-label"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label text="&#9679;" styleClass="text-emerald text-xs"/>
                    <Label text="Done"       styleClass="hint-label"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label text="&#9679;" styleClass="text-red text-xs"/>
                    <Label text="Error"      styleClass="hint-label"/>
                </HBox>
            </HBox>
        </HBox>

        <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <columns>
                <TableColumn fx:id="fileNameColumn"       text="FILE NAME"       prefWidth="240"/>
                <TableColumn fx:id="predictedClassColumn" text="PREDICTED CLASS"  prefWidth="200"/>
                <TableColumn fx:id="confidenceColumn"     text="CONFIDENCE"       prefWidth="120"/>
                <TableColumn fx:id="inferenceTimeColumn"  text="TIME (MS)"        prefWidth="110"/>
                <TableColumn fx:id="statusColumn"         text="STATUS"           prefWidth="140"/>
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="14">
                    <Label text="&#9673;" styleClass="text-dim" style="-fx-font-size: 40px;"/>
                    <Label text="No results yet"
                           styleClass="text-secondary text-bold text-lg"/>
                    <Label text="Select a folder and click Run Analysis to start parallel batch inference"
                           styleClass="hint-label"
                           style="-fx-wrap-text: true; -fx-text-alignment: center;"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>

</VBox>