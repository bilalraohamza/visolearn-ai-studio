<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.visolearn.ClassifyController"
      style="-fx-background-color: #1a1a2e; -fx-padding: 20;"
      spacing="20">

    <!-- ===== LEFT PANEL — IMAGE INPUT ===== -->
    <VBox spacing="12" prefWidth="420"
          style="-fx-background-color: #16213e;
                 -fx-padding: 16;
                 -fx-background-radius: 8;">

        <Label text="Input Image"
               style="-fx-font-size: 11px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #888888;
                      -fx-padding: 0 0 4 0;"/>

        <!-- Image display area with drag and drop -->
        <StackPane fx:id="imageContainer"
                   prefWidth="380" prefHeight="380"
                   minWidth="380" minHeight="380"
                   style="-fx-background-color: #0f3460;
                          -fx-background-radius: 6;
                          -fx-border-color: #378ADD;
                          -fx-border-width: 1;
                          -fx-border-radius: 6;">

            <!-- Placeholder text when no image loaded -->
            <VBox alignment="CENTER" spacing="8"
                  fx:id="placeholderBox">
                <Label text="Drop image here"
                       style="-fx-font-size: 16px;
                              -fx-text-fill: #378ADD;"/>
                <Label text="or click Upload Image below"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #666666;"/>
                <Label text="Supports: JPG, PNG"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #444444;"/>
            </VBox>

            <!-- Image view — hidden until image is loaded -->
            <ImageView fx:id="inputImageView"
                       fitWidth="380" fitHeight="380"
                       preserveRatio="true"
                       visible="false"/>

            <!-- Grad-CAM overlay — shown when toggle is on -->
            <ImageView fx:id="heatmapImageView"
                       fitWidth="380" fitHeight="380"
                       preserveRatio="true"
                       visible="false"
                       opacity="0.45"/>
        </StackPane>

        <!-- Upload and webcam buttons -->
        <HBox spacing="10">
            <Button fx:id="uploadButton"
                    text="Upload Image"
                    onAction="#handleUpload"
                    prefWidth="190"
                    style="-fx-background-color: #378ADD;
                           -fx-text-fill: white;
                           -fx-font-size: 12px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 8 16 8 16;
                           -fx-cursor: hand;"/>
            <Button fx:id="clearButton"
                    text="Clear"
                    onAction="#handleClear"
                    prefWidth="90"
                    style="-fx-background-color: #2a2a4a;
                           -fx-text-fill: #888888;
                           -fx-font-size: 12px;
                           -fx-background-radius: 6;
                           -fx-padding: 8 16 8 16;
                           -fx-cursor: hand;"/>
        </HBox>

        <!-- Grad-CAM toggle -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <CheckBox fx:id="gradCamToggle"
                      text="Show Grad-CAM Heatmap"
                      onAction="#handleGradCamToggle"
                      style="-fx-text-fill: #aaaaaa;
                             -fx-font-size: 12px;"/>
        </HBox>

        <!-- Loading indicator -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              fx:id="loadingBox" visible="false">
            <ProgressIndicator fx:id="loadingSpinner"
                               prefWidth="20" prefHeight="20"/>
            <Label fx:id="loadingLabel"
                   text="Running inference..."
                   style="-fx-text-fill: #378ADD;
                          -fx-font-size: 12px;"/>
        </HBox>

    </VBox>

    <!-- ===== RIGHT PANEL — PREDICTION RESULTS ===== -->
    <VBox spacing="16" HBox.hgrow="ALWAYS"
          style="-fx-background-color: #16213e;
                 -fx-padding: 16;
                 -fx-background-radius: 8;">

        <Label text="Prediction Result"
               style="-fx-font-size: 11px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #888888;"/>

        <!-- Top prediction box -->
        <VBox fx:id="predictionBox"
              style="-fx-background-color: #0f3460;
                     -fx-padding: 16;
                     -fx-background-radius: 8;"
              spacing="4">
            <Label text="Detected Class"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #378ADD;
                          -fx-font-weight: bold;"/>
            <Label fx:id="predictionLabel"
                   text="Upload an image to classify"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #e0e0e0;"/>
            <Label fx:id="confidenceLabel"
                   text=""
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #378ADD;"/>
            <Label fx:id="inferenceTimeLabel"
                   text=""
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #666666;"/>
        </VBox>

        <!-- All class confidence bars -->
        <Label text="All Class Scores"
               style="-fx-font-size: 11px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #888888;"/>

        <VBox fx:id="confidenceBarsBox" spacing="8">

            <!-- akiec -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Actinic Keratosis"
                       prefWidth="180"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #aaaaaa;"/>
                <ProgressBar fx:id="bar0" progress="0"
                             prefWidth="200" prefHeight="12"
                             style="-fx-accent: #4C72B0;"/>
                <Label fx:id="pct0" text="0%"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #888888;
                              -fx-min-width: 40px;"/>
            </HBox>

            <!-- bcc -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Basal Cell Carcinoma"
                       prefWidth="180"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #aaaaaa;"/>
                <ProgressBar fx:id="bar1" progress="0"
                             prefWidth="200" prefHeight="12"
                             style="-fx-accent: #DD8452;"/>
                <Label fx:id="pct1" text="0%"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #888888;
                              -fx-min-width: 40px;"/>
            </HBox>

            <!-- bkl -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Benign Keratosis"
                       prefWidth="180"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #aaaaaa;"/>
                <ProgressBar fx:id="bar2" progress="0"
                             prefWidth="200" prefHeight="12"
                             style="-fx-accent: #55A868;"/>
                <Label fx:id="pct2" text="0%"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #888888;
                              -fx-min-width: 40px;"/>
            </HBox>

            <!-- df -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Dermatofibroma"
                       prefWidth="180"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #aaaaaa;"/>
                <ProgressBar fx:id="bar3" progress="0"
                             prefWidth="200" prefHeight="12"
                             style="-fx-accent: #C44E52;"/>
                <Label fx:id="pct3" text="0%"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #888888;
                              -fx-min-width: 40px;"/>
            </HBox>

            <!-- mel -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Melanoma"
                       prefWidth="180"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #aaaaaa;"/>
                <ProgressBar fx:id="bar4" progress="0"
                             prefWidth="200" prefHeight="12"
                             style="-fx-accent: #8172B2;"/>
                <Label fx:id="pct4" text="0%"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #888888;
                              -fx-min-width: 40px;"/>
            </HBox>

            <!-- nv -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Melanocytic Nevus"
                       prefWidth="180"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #aaaaaa;"/>
                <ProgressBar fx:id="bar5" progress="0"
                             prefWidth="200" prefHeight="12"
                             style="-fx-accent: #937860;"/>
                <Label fx:id="pct5" text="0%"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #888888;
                              -fx-min-width: 40px;"/>
            </HBox>

            <!-- vasc -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Vascular Lesion"
                       prefWidth="180"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #aaaaaa;"/>
                <ProgressBar fx:id="bar6" progress="0"
                             prefWidth="200" prefHeight="12"
                             style="-fx-accent: #DA8BC3;"/>
                <Label fx:id="pct6" text="0%"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #888888;
                              -fx-min-width: 40px;"/>
            </HBox>

        </VBox>

        <!-- Class description box -->
        <VBox style="-fx-background-color: #0f3460;
                     -fx-padding: 12;
                     -fx-background-radius: 8;"
              spacing="4">
            <Label text="About this condition"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #378ADD;
                          -fx-font-weight: bold;"/>
            <Label fx:id="descriptionLabel"
                   text="Upload a dermoscopy image to see classification results and Grad-CAM explanation."
                   wrapText="true"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #888888;"/>
        </VBox>

    </VBox>

</HBox>