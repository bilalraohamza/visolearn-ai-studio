<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.visolearn.DashboardController"
      styleClass="page-root"
      spacing="20">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4">
            <Label text="Training Dashboard" styleClass="page-title"/>
            <Label text="Dual-Model Ensemble evaluated on HAM10000 + ISIC2019"
                   styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="reloadButton" text="Reload Metrics"
                onAction="#handleReload" styleClass="secondary-btn"
                style="-fx-padding: 8 16 8 16;"/>
    </HBox>

    <!-- KPI row -->
    <HBox spacing="16">
        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 16;">
            <Label text="BEST VAL ACCURACY" styleClass="section-cap" style="-fx-padding: 0 0 8 0;"/>
            <Label fx:id="bestAccLabel" text="&#8212;" styleClass="stat-value-emerald"/>
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                <Label fx:id="bestEpochLabel" text="Loading data..." styleClass="hint-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="peakLabel" text="peak" styleClass="text-emerald text-bold text-sm"/>
            </HBox>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 16;">
            <Label text="TEST ACCURACY" styleClass="section-cap" style="-fx-padding: 0 0 8 0;"/>
            <Label fx:id="testAccLabel" text="&#8212;" styleClass="stat-value-cyan"/>
            <HBox style="-fx-padding: 8 0 0 0;">
                <Label text="ensemble evaluation" styleClass="hint-label"/>
            </HBox>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 16;">
            <Label text="MACRO F1" styleClass="section-cap" style="-fx-padding: 0 0 8 0;"/>
            <Label fx:id="macroF1Label" text="&#8212;" styleClass="stat-value-purple"/>
            <HBox style="-fx-padding: 8 0 0 0;">
                <Label text="weighted: 0.816" styleClass="hint-label"/>
            </HBox>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 16;">
            <Label text="PARAMETERS" styleClass="section-cap" style="-fx-padding: 0 0 8 0;"/>
            <Label text="31.5M" styleClass="stat-value"/>
            <HBox style="-fx-padding: 8 0 0 0;">
                <Label text="EffNet-B4 + DenseNet-169" styleClass="hint-label"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- Charts row -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 16;"
              spacing="8" alignment="CENTER">
            <Label text="Training &amp; Validation Loss" styleClass="chart-title"/>
            <LineChart fx:id="lossChart" VBox.vgrow="ALWAYS" animated="false"
                       styleClass="bg-base" style="-fx-padding: 0;">
                <xAxis><NumberAxis label="Epoch" lowerBound="1" upperBound="35"
                                   tickUnit="5" autoRanging="false"
                                   styleClass="text-secondary"/></xAxis>
                <yAxis><NumberAxis label="Loss" autoRanging="true"
                                   styleClass="text-secondary"/></yAxis>
            </LineChart>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card" style="-fx-padding: 16;"
              spacing="8" alignment="CENTER">
            <Label text="Training &amp; Validation Accuracy" styleClass="chart-title"/>
            <LineChart fx:id="accuracyChart" VBox.vgrow="ALWAYS" animated="false"
                       styleClass="bg-base" style="-fx-padding: 0;">
                <xAxis><NumberAxis label="Epoch" lowerBound="1" upperBound="35"
                                   tickUnit="5" autoRanging="false"
                                   styleClass="text-secondary"/></xAxis>
                <yAxis><NumberAxis label="Accuracy (%)" autoRanging="true"
                                   styleClass="text-secondary"/></yAxis>
            </LineChart>
        </VBox>
    </HBox>

    <!-- Per-class F1 grid -->
    <VBox styleClass="glass-card" style="-fx-padding: 20;" spacing="16"
          VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label text="ENSEMBLE PER-CLASS F1 SCORE" styleClass="section-cap-spaced"/>
            <Label text="Averaged results from ensemble evaluation" styleClass="hint-label"/>
        </VBox>

        <GridPane hgap="32" vgap="14">
            <Label text="Actinic Keratosis"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"
                   styleClass="bar-class-label"/>
            <ProgressBar fx:id="bar0" progress="0"
                         GridPane.columnIndex="1" GridPane.rowIndex="0"
                         prefWidth="250" prefHeight="8"
                         style="-fx-accent: #38BDF8;"/>
            <Label fx:id="pct0" text="0.000"
                   GridPane.columnIndex="2" GridPane.rowIndex="0"
                   styleClass="bar-pct"/>

            <Label text="Basal Cell Carcinoma"
                   GridPane.columnIndex="3" GridPane.rowIndex="0"
                   styleClass="bar-class-label" style="-fx-padding: 0 0 0 16;"/>
            <ProgressBar fx:id="bar1" progress="0"
                         GridPane.columnIndex="4" GridPane.rowIndex="0"
                         prefWidth="250" prefHeight="8"
                         style="-fx-accent: #F472B6;"/>
            <Label fx:id="pct1" text="0.000"
                   GridPane.columnIndex="5" GridPane.rowIndex="0"
                   styleClass="bar-pct"/>

            <Label text="Benign Keratosis"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"
                   styleClass="bar-class-label"/>
            <ProgressBar fx:id="bar2" progress="0"
                         GridPane.columnIndex="1" GridPane.rowIndex="1"
                         prefWidth="250" prefHeight="8"
                         style="-fx-accent: #A78BFA;"/>
            <Label fx:id="pct2" text="0.000"
                   GridPane.columnIndex="2" GridPane.rowIndex="1"
                   styleClass="bar-pct"/>

            <Label text="Dermatofibroma"
                   GridPane.columnIndex="3" GridPane.rowIndex="1"
                   styleClass="bar-class-label" style="-fx-padding: 0 0 0 16;"/>
            <ProgressBar fx:id="bar3" progress="0"
                         GridPane.columnIndex="4" GridPane.rowIndex="1"
                         prefWidth="250" prefHeight="8"
                         style="-fx-accent: #FB923C;"/>
            <Label fx:id="pct3" text="0.000"
                   GridPane.columnIndex="5" GridPane.rowIndex="1"
                   styleClass="bar-pct"/>

            <Label text="Melanoma"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"
                   styleClass="bar-class-red"/>
            <ProgressBar fx:id="bar4" progress="0"
                         GridPane.columnIndex="1" GridPane.rowIndex="2"
                         prefWidth="250" prefHeight="8"
                         style="-fx-accent: #EF4444;"/>
            <Label fx:id="pct4" text="0.000"
                   GridPane.columnIndex="2" GridPane.rowIndex="2"
                   styleClass="bar-pct-red"/>

            <Label text="Melanocytic Nevus"
                   GridPane.columnIndex="3" GridPane.rowIndex="2"
                   styleClass="bar-class-green" style="-fx-padding: 0 0 0 16;"/>
            <ProgressBar fx:id="bar5" progress="0"
                         GridPane.columnIndex="4" GridPane.rowIndex="2"
                         prefWidth="250" prefHeight="8"
                         style="-fx-accent: #10B981;"/>
            <Label fx:id="pct5" text="0.000"
                   GridPane.columnIndex="5" GridPane.rowIndex="2"
                   styleClass="bar-pct-green"/>

            <Label text="Vascular Lesion"
                   GridPane.columnIndex="0" GridPane.rowIndex="3"
                   styleClass="bar-class-label"/>
            <ProgressBar fx:id="bar6" progress="0"
                         GridPane.columnIndex="1" GridPane.rowIndex="3"
                         prefWidth="250" prefHeight="8"
                         style="-fx-accent: #FBBF24;"/>
            <Label fx:id="pct6" text="0.000"
                   GridPane.columnIndex="2" GridPane.rowIndex="3"
                   styleClass="bar-pct"/>
        </GridPane>
    </VBox>

</VBox>