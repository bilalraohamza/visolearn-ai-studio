<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #111127;">

    <!-- TOP HEADER BAR -->
    <top>
        <VBox style="-fx-background-color: #161630;
                     -fx-padding: 12 20 12 20;
                     -fx-border-color: rgba(255,255,255,0.07);
                     -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="14">

                <!-- Brand icon + name -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane style="-fx-background-color: linear-gradient(to bottom right, #4d9de0, #22c55e);
                                     -fx-background-radius: 9;
                                     -fx-min-width: 32;
                                     -fx-min-height: 32;
                                     -fx-max-width: 32;
                                     -fx-max-height: 32;">
                        <Label text="V"
                               style="-fx-font-size: 14px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="VisoLearn AI Studio"
                               style="-fx-font-size: 15px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #f0f0fa;"/>
                        <Label text="Skin Lesion Classification with Grad-CAM Explanation"
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #606080;"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Meta chips -->
                <HBox alignment="CENTER" spacing="8">
                    <Label text="EfficientNet-B4"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #a0a0c0;
                                  -fx-background-color: transparent;
                                  -fx-border-color: rgba(255,255,255,0.12);
                                  -fx-border-radius: 20;
                                  -fx-background-radius: 20;
                                  -fx-padding: 4 10 4 10;"/>
                    <Label text="HAM10000"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #a0a0c0;
                                  -fx-border-color: rgba(255,255,255,0.12);
                                  -fx-border-radius: 20;
                                  -fx-background-radius: 20;
                                  -fx-padding: 4 10 4 10;"/>
                    <Label text="80.99% Test Accuracy"
                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #6fb4f0;
                                  -fx-background-color: rgba(77,157,224,0.12);
                                  -fx-border-color: rgba(77,157,224,0.3);
                                  -fx-border-radius: 20;
                                  -fx-background-radius: 20;
                                  -fx-padding: 4 12 4 12;"/>
                </HBox>

            </HBox>
        </VBox>
    </top>

    <!-- MAIN TAB PANE -->
    <center>
        <TabPane fx:id="mainTabPane"
                 tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #111127;
                        -fx-tab-min-height: 42px;
                        -fx-tab-max-height: 42px;">

            <Tab text="Classify">
                <fx:include source="classify_tab.fxml"/>
            </Tab>

            <Tab text="Training Dashboard">
                <fx:include source="dashboard_tab.fxml"/>
            </Tab>

            <Tab text="Batch Analysis">
                <fx:include source="batch_tab.fxml"/>
            </Tab>

        </TabPane>
    </center>

    <!-- STATUS BAR -->
    <bottom>
        <HBox style="-fx-background-color: #161630;
                     -fx-padding: 6 18 6 18;
                     -fx-border-color: rgba(255,255,255,0.07);
                     -fx-border-width: 1 0 0 0;"
              alignment="CENTER_LEFT"
              spacing="12">

            <HBox alignment="CENTER_LEFT" spacing="6">
                <StackPane style="-fx-background-color: #22c55e;
                                  -fx-background-radius: 50;
                                  -fx-min-width: 7;
                                  -fx-min-height: 7;
                                  -fx-max-width: 7;
                                  -fx-max-height: 7;"/>
                <Label text="Model loaded"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #606080;"/>
            </HBox>

            <Label text="|"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: rgba(255,255,255,0.1);"/>
            <Label text="EfficientNet-B4 · 17.5M params"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #606080;"/>
            <Label text="|"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: rgba(255,255,255,0.1);"/>
            <Label text="HAM10000 · 7 classes"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #606080;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="VisoLearn AI Studio v1.0  |  Rao Hamza Bilal"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #606080;"/>
        </HBox>
    </bottom>

</BorderPane>