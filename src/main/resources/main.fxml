<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="rootPane"
           fx:controller="com.visolearn.MainController">

    <BorderPane styleClass="bg-base">

        <top>
            <VBox styleClass="navbar">
                <HBox alignment="CENTER_LEFT" spacing="14">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane styleClass="logo-icon" alignment="CENTER">
                            <Label text="V" styleClass="logo-v"/>
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="VisoLearn AI Studio" styleClass="logo-text"/>
                            <Label text="Skin Lesion Classification with Occlusion Sensitivity Analysis"
                                   styleClass="logo-sub"/>
                        </VBox>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER" spacing="8">
                        <Label text="EfficientNet-B4 + DenseNet-169"
                               styleClass="badge-pill"/>
                        <Label text="HAM10000 + ISIC2019"
                               styleClass="badge-pill"/>
                        <Label text="Dual-Model Ensemble"
                               styleClass="badge-pill-emerald"/>
                        <Region prefWidth="12"/>
                        <Button text="&#9881; Settings"
                                onAction="#handleOpenSettings"
                                styleClass="secondary-btn"
                                style="-fx-padding: 4 12 4 12; -fx-font-size: 11px;"/>
                    </HBox>

                </HBox>
            </VBox>
        </top>

        <center>
            <TabPane fx:id="mainTabPane"
                     tabClosingPolicy="UNAVAILABLE"
                     styleClass="bg-base"
                     style="-fx-tab-min-height: 42px; -fx-tab-max-height: 42px;">

                <Tab text="Classify">
                    <fx:include source="classify_tab.fxml"/>
                </Tab>
                <Tab text="Training Dashboard">
                    <fx:include source="dashboard_tab.fxml"/>
                </Tab>
                <Tab text="Batch Analysis">
                    <fx:include source="batch_tab.fxml"/>
                </Tab>
                <Tab text="History">
                    <fx:include source="history_tab.fxml"/>
                </Tab>

            </TabPane>
        </center>

        <bottom>
            <HBox styleClass="statusbar" alignment="CENTER_LEFT" spacing="12">

                <HBox alignment="CENTER_LEFT" spacing="6">
                    <StackPane styleClass="status-dot"/>
                    <Label text="Ensemble loaded" styleClass="meta-label"/>
                </HBox>

                <Label text="|" styleClass="divider-label"/>
                <Label text="EfficientNet + DenseNet" styleClass="meta-label"/>
                <Label text="|" styleClass="divider-label"/>
                <Label text="7 Clinical Classes" styleClass="meta-label"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="VisoLearn AI Studio v2.0 | Rao Hamza Bilal"
                       styleClass="meta-label"/>
            </HBox>
        </bottom>

    </BorderPane>

</StackPane>